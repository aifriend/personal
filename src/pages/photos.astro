---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { plates } from '../lib/plates';
---

<Base
  title="Photographs — Jose Lopez"
  description="Photographs by Jose Lopez — a cross of carnations, ferns at the base of a tree, a stone Christ, and one picture of Pluto."
>
  <Nav />
  <main class="relative px-8 sm:px-14 pt-[120px] pb-[140px]">
    <div class="font-mono text-[11px] tracking-[0.18em] uppercase opacity-55 mb-8 flex items-center gap-3">
      <span class="block w-7 h-px bg-ink opacity-40"></span>
      Photos · the full set
    </div>
    <h1 class="font-serif font-light italic leading-[0.95] m-0 mb-16 -tracking-[0.02em]"
        style="font-size: clamp(56px, 7vw, 96px);">
      Photographs,<br />all of them.
    </h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-16 max-w-[1100px]">
      {plates.map((p) => (
        <article class="flex flex-col">
          <div class="relative">
            <Image
              src={p.image}
              alt={p.title}
              loading="lazy"
              widths={[480, 800, 1200]}
              sizes="(min-width: 1100px) 540px, (min-width: 640px) 50vw, 100vw"
              quality={80}
              format="webp"
              class="w-full h-auto block"
            />
            <div class="absolute top-3 right-3 font-serif italic text-lg text-white opacity-85 drop-shadow">№ {p.no}</div>
          </div>
          <div class="mt-5">
            <h2 class={`font-serif font-normal italic m-0 ${p.serifSize}`}>{p.title}</h2>
          </div>
          {p.caption && (
            <p class="mt-3 text-sm leading-[1.6] opacity-70 max-w-[52ch]">{p.caption}</p>
          )}
        </article>
      ))}
    </div>

    <div class="mt-16 flex flex-wrap items-center gap-x-10 gap-y-4">
      <a href="/#photos" class="font-serif italic text-lg fn-serif-link text-ink">
        ← back to the index
      </a>
      <a href="https://www.instagram.com/joseafdlopez/" target="_blank" rel="me noopener noreferrer"
         class="font-serif italic text-lg fn-serif-link text-ink">
        more on Instagram →
      </a>
    </div>
  </main>
</Base>
