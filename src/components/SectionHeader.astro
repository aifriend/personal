---
interface Props {
  number: string;
  label: string;
  title: string;
  titleBreak?: string;
}
const { number, label, title, titleBreak } = Astro.props;
---

<div class="flex justify-between items-end mb-16 pb-6 border-b border-ink/13">
  <h2 class="font-serif font-light italic m-0 leading-[0.95] -tracking-[0.02em]"
      style="font-size: clamp(56px, 7vw, 96px);">
    {title}{titleBreak && (<><br />{titleBreak}</>)}
  </h2>
  <div class="text-right font-mono text-[11px] tracking-[0.18em] opacity-60 uppercase shrink-0 ml-6">
    <div class="text-accent text-sm mb-1">{number}</div>
    <div>{label}</div>
  </div>
</div>
