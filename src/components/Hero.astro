---
// Professional positioning row — facts only, all verifiable (GitHub bio, repos, PhD proposal).
const facts = [
  ['Base', 'Madrid, ES'],
  ['Fields', 'Neuroscience × AI'],
  ['Research', 'Neural population dynamics — PhD'],
  ['Practice', 'EEG-BCI · neuroevolution · photography'],
];
---

<section class="px-8 sm:px-14 pt-[90px] pb-[110px] relative z-10">
  <div class="grid lg:grid-cols-[1.15fr_1fr] gap-14 items-start">
    <div>
      <div class="lg:hidden font-mono text-[11px] tracking-[0.18em] uppercase opacity-55 mb-8 flex items-center gap-3">
        <span class="block w-7 h-px bg-ink opacity-40"></span>
        Madrid, ES — neuroscience × AI × photography
      </div>
      <h1 class="font-serif font-light leading-[1.04] m-0 -tracking-[0.03em] text-ink"
          style="font-size: clamp(48px, 6.4vw, 100px);">
        Minds, machines, and<br />
        the <em class="italic font-light text-accent">photographs</em> between.
      </h1>
      <p class="mt-9 text-[17px] leading-[1.7] text-ink-soft max-w-[52ch]">
        Jose Lopez is a researcher and photographer based in Madrid. The
        science: EEG brain–computer interfaces, neuroevolution, and a
        doctoral project on the geometry of computation in neural
        populations. The photographs: the same attention, practiced with
        a camera.
      </p>
    </div>
    <div class="bg-cream-soft border border-ink/10 p-7 sm:p-9">
      <div class="hidden lg:flex font-mono text-[10px] tracking-[0.18em] uppercase opacity-55 mb-7 items-center gap-3">
        <span class="block w-7 h-px bg-ink opacity-40"></span>
        Madrid, ES — neuroscience × AI × photography
      </div>
      <div class="grid grid-cols-2 gap-x-8 gap-y-8">
        {facts.map(([k, v]) => (
          <div class="pt-4 border-t border-ink/13">
            <div class="font-mono text-[10px] tracking-[0.18em] uppercase opacity-50 mb-2">{k}</div>
            <div class="font-serif italic text-[17px] font-normal leading-[1.35]">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
