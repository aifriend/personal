---
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import { researchRows } from '../lib/research-rows';
import { href } from '../lib/base';

// Find which slugs have a real Markdown document, and their status
const docs = await getCollection('research');
const writtenSlugs = new Set(docs.map((d) => d.id));
const statusBySlug = new Map(docs.map((d) => [d.id, d.data.status]));

// Group rows by theme, preserving the canonical order from research-rows.ts.
const groups: { name: string; rows: typeof researchRows }[] = [];
for (const row of researchRows) {
  const last = groups[groups.length - 1];
  if (last && last.name === row.group) last.rows.push(row);
  else groups.push({ name: row.group, rows: [row] });
}

// Pastel panel per theme (redesign PDF p.4). Keys are the `group` strings.
const tintByGroup: Record<string, string> = {
  'Mind & Cognition': 'bg-periwinkle',
  'Neuroscience': 'bg-rose',
  'Memory & Learning': 'bg-sage',
  'AI & Agents': 'bg-lilac',
  'Field & Practice': 'bg-sand',
};
---

<section id="research" class="px-8 sm:px-14 pt-[100px] pb-[120px] relative z-10">
  <SectionHeader number="01" label="Research" title="Mind, brain, and" accent="machine.">
    <span slot="right" class="font-mono text-[11px] tracking-[0.15em] opacity-50 uppercase">
      {researchRows.length} entries · {groups.length} themes · ongoing
    </span>
  </SectionHeader>

  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-5 items-start">
    {groups.map((g) => (
      <div class={`${tintByGroup[g.name] ?? 'bg-cream-soft'} p-4 rounded-[5px]`}>
        <div class="flex justify-between items-baseline px-1.5 pb-3.5">
          <span class="font-mono text-[10px] tracking-[0.15em] uppercase opacity-70">{g.name}</span>
          <span class="font-serif font-light text-[32px] leading-none">{String(g.rows.length).padStart(2, '0')}</span>
        </div>
        <div class="flex flex-col gap-3">
          {g.rows.map((row) => {
            const written = writtenSlugs.has(row.slug);
            const status = statusBySlug.get(row.slug);
            const card = (
              <>
                <div class="flex justify-between items-baseline">
                  <span class="font-mono text-[10px] opacity-55 tracking-wider">{row.no}</span>
                  <span class="text-[13px] opacity-50 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-1">{written ? '→' : '·'}</span>
                </div>
                <div class="mt-1 font-serif italic font-normal text-[19px] leading-[1.22]">{row.title}</div>
                <div class="mt-2.5 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-[9.5px] tracking-[0.12em] uppercase opacity-65">
                  <span>{row.kind}</span>
                  {status && (
                    <span class="flex items-center gap-1.5">
                      <span class="text-accent text-[8px]">●</span>{status}
                    </span>
                  )}
                </div>
              </>
            );
            const cardClass = 'group block bg-cream rounded-[3px] p-4 transition-transform duration-300 hover:-translate-y-0.5';
            return written ? (
              <a href={href(`/research/${row.slug}`)} class={`${cardClass} no-underline text-ink`}>
                {card}
              </a>
            ) : (
              <div class={`${cardClass} opacity-70`} title="not yet written">
                {card}
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>
