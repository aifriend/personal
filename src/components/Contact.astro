---
const channels = [
  ['Email',    'contacto@doctorjosette.com', 'mailto:contacto@doctorjosette.com'],
  ['Web',      'doctorjosette.com',          'https://doctorjosette.com'],
  ['Photos',   '@joseafdlopez',              'https://www.instagram.com/joseafdlopez/'],
  ['Code',     '@aifriend',                  'https://github.com/aifriend'],
  ['LinkedIn', '@jafdl',                     'https://www.linkedin.com/in/jafdl'],
];
---

<section id="say-hi" class="px-8 sm:px-14 pt-[180px] pb-[120px] relative z-10"
         style="background: linear-gradient(180deg, transparent, var(--color-cream-deep));">
  <div class="grid lg:grid-cols-[2fr_3fr] gap-16 items-end">
    <div>
      <div class="font-mono text-[11px] tracking-[0.18em] opacity-55 uppercase mb-8 flex items-center gap-3">
        <span class="block w-7 h-px bg-ink opacity-40"></span>
        04 — Contact
      </div>
      <h2 class="font-serif font-light leading-[0.95] m-0 -tracking-[0.025em]"
          style="font-size: clamp(56px, 7vw, 108px);">
        Get in <em class="italic font-light text-accent">touch</em>.
      </h2>
      <p class="mt-7 font-serif italic text-xl leading-[1.5] text-ink-soft max-w-[30ch]">
        For research, collaborations, or questions about the
        work — email is the surest line.
      </p>
    </div>
    <ul class="list-none p-0 m-0 grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-4">
      {channels.map(([k, v, href], i) => (
        <li class={i === 0 ? 'col-span-2 sm:col-span-1' : ''}>
          <a href={href}
             target={href.startsWith('mailto:') ? '_self' : '_blank'}
             rel={href.startsWith('mailto:') ? undefined : 'me noopener noreferrer'}
             class="group block h-full bg-cream-soft border border-ink/10 p-5 no-underline text-ink transition-colors duration-300 hover:border-accent/50">
            <span class="block font-mono text-[10px] tracking-[0.18em] uppercase opacity-60">{k}</span>
            <span class="block mt-6 font-serif italic text-[16px] leading-[1.35] break-all group-hover:text-accent transition-colors duration-300">{v}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<footer class="px-8 sm:px-14 py-9 text-[11px] tracking-[0.18em] uppercase opacity-55 flex flex-wrap justify-between gap-4 border-t border-ink/13 relative z-10 font-mono">
  <span>© MMXXVI · Jose Lopez</span>
  <span>set in Fraunces &amp; Inter</span>
  <span>Madrid, ES</span>
</footer>
