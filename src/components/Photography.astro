---
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import { plates } from '../lib/plates';
import { href } from '../lib/base';

// Homepage shows a selection; the full set lives on /photos.
const strip = plates.slice(0, 6);
---

<section id="photos" class="px-8 sm:px-14 pt-[120px] pb-20 relative z-10">
  <SectionHeader number="03" label="Photography" title="Selected" accent="frames.">
    <a slot="right" href={href('/photos')} class="font-serif italic text-xl fn-serif-link text-ink">
      see all photographs →
    </a>
  </SectionHeader>

  <div class="grid grid-cols-2 gap-x-5 gap-y-12 sm:flex sm:gap-6 sm:overflow-x-auto sm:pb-4">
    {strip.map((p) => (
      <article class="sm:shrink-0 sm:w-[300px]">
        <Image
          src={p.image}
          alt={p.title}
          loading="lazy"
          widths={[300, 480, 640]}
          sizes="(min-width: 640px) 300px, 50vw"
          quality={80}
          format="webp"
          class="w-full aspect-[3/4] object-cover block"
        />
        <div class="mt-3 flex items-baseline gap-2.5">
          <span class="font-mono text-[10px] tracking-[0.15em] uppercase opacity-50 shrink-0">№ {p.no}</span>
          <h3 class="font-serif italic font-normal text-[15px] leading-[1.3] m-0">{p.title}</h3>
        </div>
        {p.caption && (
          <p class="mt-1.5 text-[12px] leading-[1.5] opacity-65 m-0">{p.caption}</p>
        )}
      </article>
    ))}
  </div>
</section>
