---
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';

// Importing photos from src/assets lets Astro auto-generate WebP/AVIF + responsive sizes.
// The 22 MB PNG drops to ~600 KB at viewport width.
import photo1 from '../assets/photos/photo-1.png';
import photo2 from '../assets/photos/photo-2.png';
import photo3 from '../assets/photos/photo-3.jpg';
import photo4 from '../assets/photos/photo-4.jpg';

interface Plate {
  image: ImageMetadata;
  no: string;
  title: string;   // honest description of what's in the frame — not invented narrative
  caption?: string; // used only where a factual note is genuinely true
  serifSize: string;
}

// Titles describe what is actually in each photo. Captions were invented and
// have been removed — add true ones in your own words later (see AUTHENTICITY-PASS.md).
const plates: Plate[] = [
  {
    image: photo1,
    no: '01',
    title: 'A cross of carnations.',
    serifSize: 'text-[26px]',
  },
  {
    image: photo2,
    no: '02',
    title: 'Ferns at the base of a tree.',
    serifSize: 'text-[24px]',
  },
  {
    image: photo3,
    no: '03',
    title: 'A stone Christ.',
    serifSize: 'text-[24px]',
  },
  {
    image: photo4,
    no: '04',
    title: 'Pluto.',
    caption: "New Horizons, NASA — the one picture here I didn't take.",
    serifSize: 'text-[24px]',
  },
];
---

<section id="photos" class="px-8 sm:px-14 pt-[120px] pb-20 relative z-10">
  <SectionHeader number="01" label="Photos" title="Selected," titleBreak="recently." />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-16 max-w-[1100px] mx-auto">
    {plates.map((p) => (
      <article class="flex flex-col">
        <div class="relative">
          <Image
            src={p.image}
            alt={p.title}
            loading="lazy"
            widths={[480, 800, 1200]}
            sizes="(min-width: 1100px) 540px, (min-width: 640px) 50vw, 100vw"
            quality={85}
            format="webp"
            class="w-full h-auto block"
          />
          {/* number only — the invented ratio/device labels were removed */}
          <div class="absolute top-3 right-3 font-serif italic text-lg text-white opacity-85 drop-shadow">№ {p.no}</div>
        </div>
        <div class="mt-5">
          <h3 class={`font-serif font-normal italic m-0 ${p.serifSize}`}>{p.title}</h3>
        </div>
        {p.caption && (
          <p class="mt-3 text-sm leading-[1.6] opacity-70 max-w-[52ch]">{p.caption}</p>
        )}
      </article>
    ))}
  </div>

  <div class="mt-14 text-right max-w-[1100px] mx-auto">
    <a href="https://www.instagram.com/joseafdlopez/" target="_blank" rel="noopener noreferrer" class="font-serif italic text-xl fn-serif-link text-ink">
      see all photographs →
    </a>
  </div>
</section>
