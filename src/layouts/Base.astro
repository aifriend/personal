---
import '../styles/global.css';
import { href } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
}

const {
  title = 'Jose Lopez — neuroscience · AI · photography',
  description = 'Jose Lopez — Madrid-based researcher in neuroscience and artificial intelligence, and photographer. Research notes, open code, and selected photographs.',
  ogImage = '/og-image.png',
  lang = 'en',
} = Astro.props;

// Astro.site is set in astro.config.mjs and is required for absolute URLs.
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(href(ogImage), Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />

    {/* RSS feed for research pieces */}
    <link rel="alternate" type="application/rss+xml" title="Jose Lopez · Research" href={href('/rss.xml')} />

    {/* OpenGraph (Facebook, Slack, iMessage, LinkedIn previews) */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jose Lopez — neuroscience, AI, photography" />
    <meta property="og:site_name" content="Jose Lopez" />
    <meta property="og:locale" content="en_US" />

    {/* Twitter / X card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Fonts are self-hosted via @fontsource-variable packages (see global.css) */}
    <title>{title}</title>

    {/* Identity: one person across platforms */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Jose Lopez',
      url: Astro.site?.toString(),
      address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
      sameAs: [
        'https://github.com/aifriend',
        'https://www.instagram.com/joseafdlopez/',
        'https://www.linkedin.com/in/jafdl',
        'https://doctorjosette.com',
      ],
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
